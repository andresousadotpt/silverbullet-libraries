{
  "name": "silverbullet-personal-plugs",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "A collection of independently installable SilverBullet plugs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "dev": "node scripts/dev.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@fortune-sheet/react": "1.0.4",
    "@zip.js/zip.js": "2.16.0",
    "fast-formula-parser": "1.0.19",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@silverbulletmd/silverbullet": "2.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "esbuild": "^0.25.0",
    "semantic-release": "25.0.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@silverbulletmd/silverbullet": {
      "esbuild": "0.28.2"
    }
  },
  "license": "MIT"
}
